# vibo-hook: on_send
# ViboGram plugin: same daily-gacha-pull + auto-battle mechanic as
# card_pull.vibo, reskinned as phones instead of fantasy monsters --
# "power" is a single AnTuTu-style benchmark score, battles are just
# score vs score. Two separate modes:
#
# - Practice (below, unchanged from the original version): instant,
#   fully local, fun -- but a local vibo.get_setting/set_setting file is
#   just as editable by the user as any other on-device file, so it is
#   NOT the anti-cheat-protected record.
#
# - Official (server-verified): tapping Pull/Craft/Battle opens a
#   pre-filled GitHub Issue (this plugin can't hold write credentials
#   to commit anything itself -- see build-system/game_sync.py, which
#   is the actual authority and independently re-rolls/validates
#   everything server-side, never trusting whatever the client claims).
#   Intentionally a little manual right now (check the Issue comment or
#   your record file to see what you got) -- there's no live read-back
#   into the app yet.
#
# Scores below are flavor/relative-tier numbers, not real benchmark
# results.
#
# Dot-commands (on_send hook): ".pull"/".battle"/".collection" for
# practice, ".opull"/".ocraft N"/".obattle N" for official (server-
# verified) requests -- same vibo.open_url(...) Settings... already
# uses. Everything else passes through untouched.

import random
import datetime
import urllib.parse

__name__ = "Phone Pull"

GAME_ID = "phone_pull"
REPO = "vibeDN/ViboGram"

# name, rarity, score
CARD_POOL = [
    ("Redmi Note 13", "Common", 280),
    ("Moto G Power", "Common", 220),
    ("Galaxy A15", "Common", 240),
    ("Poco C65", "Common", 200),
    ("Nokia G22", "Common", 150),
    ("iPhone SE (2022)", "Common", 300),
    ("Galaxy A05", "Common", 190),
    ("Realme C55", "Common", 230),
    ("Moto Edge Lite", "Common", 260),
    ("Redmi 12", "Common", 210),
    ("Pixel 8a", "Rare", 650),
    ("OnePlus Nord 4", "Rare", 680),
    ("Galaxy S24 FE", "Rare", 700),
    ("Poco F6", "Rare", 720),
    ("iPhone 13", "Rare", 750),
    ("Galaxy A55", "Rare", 600),
    ("iPhone 15 Pro", "Epic", 1600),
    ("Galaxy S24 Ultra", "Epic", 1550),
    ("Pixel 9 Pro", "Epic", 1400),
    ("OnePlus 12", "Epic", 1580),
    ("ASUS ROG Phone 8", "Epic", 1650),
    ("iPhone 16 Pro Max", "Legendary", 2000),
    ("Nokia 3310", "Legendary", 1),  # indestructible, computationally a potato
    ("Dual Xeon 2670v2 Homelab Rig", "Legendary", 9999),  # not a phone, cheats the pool
    # MARK: ViboGram - appended, not inserted -- this pool is now a live
    # server-authoritative economy (see game_sync.py), so every card's
    # index must stay stable forever once players can own it. New cards
    # only ever go at the end.
    ("Pixel 11 Pro XL 16GB/1TB", "Legendary", 2100),
    ("Fairphone 5", "Common", 120),  # repairable, not fast -- weakest card in the pool
]

RARITY_WEIGHTS = {"Common": 60, "Rare": 25, "Epic": 12, "Legendary": 3}
RARITY_EMOJI = {"Common": "⚪", "Rare": "🔵", "Epic": "🟣", "Legendary": "🟡"}

_INDICES_BY_RARITY = {}
for _i, _c in enumerate(CARD_POOL):
    _INDICES_BY_RARITY.setdefault(_c[1], []).append(_i)


def _pull_index():
    rarity = random.choices(list(RARITY_WEIGHTS.keys()), weights=list(RARITY_WEIGHTS.values()))[0]
    return random.choice(_INDICES_BY_RARITY[rarity])


def _card_text(idx):
    name, rarity, score = CARD_POOL[idx]
    return f"{RARITY_EMOJI.get(rarity, '')} {name} ({rarity}) Score {score}"


def _today():
    return datetime.date.today().isoformat()


def _best_index(collection):
    if not collection:
        return None
    return max(collection, key=lambda idx: CARD_POOL[idx][2])


def _issue_url(title, body):
    query = urllib.parse.urlencode({"title": title, "body": body, "labels": "game-sync"})
    return f"https://github.com/{REPO}/issues/new?{query}"


def settings(args):
    collection = vibo.get_setting("collection", [])
    last_pull = vibo.get_setting("last_pull_date", "")
    wins = vibo.get_setting("wins", 0)
    losses = vibo.get_setting("losses", 0)
    draws = vibo.get_setting("draws", 0)
    can_pull = last_pull != _today()
    username = vibo.get_setting("username", "")

    widgets = [
        {"type": "header", "text": "Phone Pull"},
        {"type": "input", "key": "username", "text": "Telegram username", "default": username, "placeholder": "your_username, no @"},
        {"type": "header", "text": "Practice (local only, not anti-cheat-protected)"},
        {"type": "action", "id": "pull", "text": "Practice Pull" if can_pull else "Already practice-pulled today"},
        {"type": "header", "text": f"Practice Collection ({len(collection)})"},
    ]

    if not collection:
        widgets.append({"type": "text", "text": "No phones yet -- pull one!"})
    else:
        best_idx = _best_index(collection)
        widgets.append({"type": "text", "text": "Best phone: " + _card_text(best_idx)})
        for idx in reversed(collection[-5:]):
            widgets.append({"type": "text", "text": _card_text(idx)})
        widgets.append({"type": "action", "id": "battle", "text": "Practice Benchmark Battle!"})

    widgets.append({"type": "text", "text": f"Practice battles: {wins}W - {losses}L - {draws}D"})

    widgets.append({"type": "header", "text": "Official (server-verified, anti-cheat)"})
    if not username:
        widgets.append({"type": "text", "text": "Set your Telegram username above first."})
    else:
        widgets.append({"type": "text", "text": "Opens a pre-filled GitHub Issue -- a bot processes it and comments the real result within a minute or so."})
        widgets.append({"type": "text", "text": "Rarity passives (real, server-enforced): Common -- craft costs 1 less. Epic -- first battle loss/day doesn't count. Legendary -- first loss/day doesn't count AND refunds the attempt."})
        widgets.append({"type": "action", "id": "official_pull", "text": "Official Pull (opens GitHub)"})
        widgets.append({"type": "input", "key": "craft_index", "text": "Card # to craft (from your last pull result / record file)", "default": vibo.get_setting("craft_index", ""), "placeholder": "e.g. 5"})
        widgets.append({"type": "action", "id": "official_craft", "text": "Official Craft (opens GitHub)"})
        widgets.append({"type": "input", "key": "battle_index", "text": "Card # to battle with (max 3 official battles/day)", "default": vibo.get_setting("battle_index", ""), "placeholder": "e.g. 5"})
        widgets.append({"type": "action", "id": "official_battle", "text": "Official Battle (opens GitHub)"})
        widgets.append({"type": "action", "id": "view_record", "text": "View my official record"})

    return widgets


def on_action(args):
    action_id = args.get("id")
    collection = vibo.get_setting("collection", [])
    last_pull = vibo.get_setting("last_pull_date", "")
    username = vibo.get_setting("username", "")

    if action_id == "pull":
        if last_pull == _today():
            vibo.toast("Already practice-pulled today -- come back tomorrow.")
            return None
        idx = _pull_index()
        collection.append(idx)
        vibo.set_setting("collection", collection)
        vibo.set_setting("last_pull_date", _today())
        rarity = CARD_POOL[idx][1]
        style = "success" if rarity in ("Epic", "Legendary") else "info"
        vibo.toast(f"You pulled: {_card_text(idx)}", style=style)
        vibo.play_sound("success" if rarity in ("Epic", "Legendary") else "default")

    elif action_id == "battle":
        if not collection:
            vibo.toast("Pull a phone first.")
            return None
        my_idx = _best_index(collection)
        opp_idx = _pull_index()
        my_score = CARD_POOL[my_idx][2]
        opp_score = CARD_POOL[opp_idx][2]
        my_name = CARD_POOL[my_idx][0]
        opp_name = CARD_POOL[opp_idx][0]
        if my_score > opp_score:
            vibo.set_setting("wins", vibo.get_setting("wins", 0) + 1)
            vibo.toast(f"{my_name} outbenches {opp_name}! You win.", style="success")
        elif my_score < opp_score:
            vibo.set_setting("losses", vibo.get_setting("losses", 0) + 1)
            vibo.toast(f"{opp_name} outbenches {my_name}. You lose.")
        else:
            vibo.set_setting("draws", vibo.get_setting("draws", 0) + 1)
            vibo.toast(f"{my_name} ties {opp_name}. Draw.")

    elif action_id == "official_pull":
        if not username:
            vibo.toast("Set your Telegram username first.")
            return None
        url = _issue_url(f"[pull:{GAME_ID}] {username}", "")
        vibo.open_url(url)
        vibo.toast("Opened GitHub -- submit the issue, then check its comments in a bit for your phone.")

    elif action_id == "official_craft":
        if not username:
            vibo.toast("Set your Telegram username first.")
            return None
        card_index = vibo.get_setting("craft_index", "")
        if not str(card_index).strip():
            vibo.toast("Enter a card number to craft first.")
            return None
        url = _issue_url(f"[craft:{GAME_ID}] {username}", f"card_index={card_index}")
        vibo.open_url(url)
        vibo.toast("Opened GitHub -- submit the issue, then check its comments for the result.")

    elif action_id == "official_battle":
        if not username:
            vibo.toast("Set your Telegram username first.")
            return None
        card_index = vibo.get_setting("battle_index", "")
        if not str(card_index).strip():
            vibo.toast("Enter a card number to battle with first.")
            return None
        url = _issue_url(f"[battle:{GAME_ID}] {username}", f"card_index={card_index}")
        vibo.open_url(url)
        vibo.toast("Opened GitHub -- submit the issue, then check its comments for the result. Max 3 official battles/day.")

    elif action_id == "view_record":
        if not username:
            vibo.toast("Set your Telegram username first.")
            return None
        vibo.open_url(f"https://raw.githubusercontent.com/{REPO}/main/players/{GAME_ID}/{username}.json")

    return None


def _cmd_pull():
    collection = vibo.get_setting("collection", [])
    last_pull = vibo.get_setting("last_pull_date", "")
    if last_pull == _today():
        return "📱 Already practice-pulled today -- come back tomorrow."
    idx = _pull_index()
    collection.append(idx)
    vibo.set_setting("collection", collection)
    vibo.set_setting("last_pull_date", _today())
    return f"📱 You pulled: {_card_text(idx)}"


def _cmd_battle():
    collection = vibo.get_setting("collection", [])
    if not collection:
        return "📱 Pull a phone first (.pull)."
    my_idx = _best_index(collection)
    opp_idx = _pull_index()
    my_score, opp_score = CARD_POOL[my_idx][2], CARD_POOL[opp_idx][2]
    my_name, opp_name = CARD_POOL[my_idx][0], CARD_POOL[opp_idx][0]
    if my_score > opp_score:
        vibo.set_setting("wins", vibo.get_setting("wins", 0) + 1)
        return f"⚔️ {my_name} outbenches {opp_name}! You win."
    elif my_score < opp_score:
        vibo.set_setting("losses", vibo.get_setting("losses", 0) + 1)
        return f"⚔️ {opp_name} outbenches {my_name}. You lose."
    vibo.set_setting("draws", vibo.get_setting("draws", 0) + 1)
    return f"⚔️ {my_name} ties {opp_name}. Draw."


def _cmd_collection():
    collection = vibo.get_setting("collection", [])
    if not collection:
        return "📱 No phones yet -- type .pull to get your first one."
    best_idx = _best_index(collection)
    wins = vibo.get_setting("wins", 0)
    losses = vibo.get_setting("losses", 0)
    draws = vibo.get_setting("draws", 0)
    return f"📱 {len(collection)} phones. Best: {_card_text(best_idx)} | {wins}W-{losses}L-{draws}D"


def _cmd_official_pull():
    username = vibo.get_setting("username", "")
    if not username:
        return "📱 Set your Telegram username in Settings… first."
    url = _issue_url(f"[pull:{GAME_ID}] {username}", "")
    vibo.open_url(url)
    return "📱 Official pull request opened in Safari -- check the GitHub issue's comments in a bit for your real phone."


def _cmd_official_craft(stripped):
    username = vibo.get_setting("username", "")
    if not username:
        return "📱 Set your Telegram username in Settings… first."
    parts = stripped.split(maxsplit=1)
    if len(parts) < 2 or not parts[1].strip().isdigit():
        return "📱 Usage: .ocraft <card number>"
    card_index = parts[1].strip()
    url = _issue_url(f"[craft:{GAME_ID}] {username}", f"card_index={card_index}")
    vibo.open_url(url)
    return f"📱 Official craft request for card #{card_index} opened in Safari -- check the issue's comments for the result."


def _cmd_official_battle(stripped):
    username = vibo.get_setting("username", "")
    if not username:
        return "📱 Set your Telegram username in Settings… first."
    parts = stripped.split(maxsplit=1)
    if len(parts) < 2 or not parts[1].strip().isdigit():
        return "📱 Usage: .obattle <card number>"
    card_index = parts[1].strip()
    url = _issue_url(f"[battle:{GAME_ID}] {username}", f"card_index={card_index}")
    vibo.open_url(url)
    return f"📱 Official battle request with card #{card_index} opened in Safari -- check the issue's comments for the result. Max 3/day."


def transform(args):
    text = args.get("text", "")
    stripped = text.strip()

    if stripped == ".pull":
        return _cmd_pull()
    if stripped == ".battle":
        return _cmd_battle()
    if stripped in (".collection", ".cards"):
        return _cmd_collection()
    if stripped == ".opull":
        return _cmd_official_pull()
    if stripped.startswith(".ocraft"):
        return _cmd_official_craft(stripped)
    if stripped.startswith(".obattle"):
        return _cmd_official_battle(stripped)

    if not text:
        collection = vibo.get_setting("collection", [])
        if not collection:
            return "Phone Pull: open Settings… and pull your first phone, or type .pull in a chat."
        best_idx = _best_index(collection)
        return f"Practice collection: {len(collection)} phones. Best: {_card_text(best_idx)}"

    return text
